# Copy this file to agent/.env and fill in your key.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
PORT=8787

# RAG (optional but recommended) — grounds answers in the book's content.
# Generate a corpus index first:  node scripts/index-site.mjs
COHERE_API_KEY=your-cohere-key
COHERE_EMBED_MODEL=embed-english-v3.0
COHERE_EMBED_DIMS=1024
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-key
QDRANT_COLLECTION=physical-ai-book
